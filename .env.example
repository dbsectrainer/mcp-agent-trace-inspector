# mcp-agent-trace-inspector environment variables
# Copy this file to .env and fill in values as needed. The server does not
# load .env files automatically; export the variables in your MCP client or
# shell environment.

# ---- HTTP transport authentication (optional) ----
# Both are applied when set. If MCP_API_KEY is set, every HTTP request must
# include X-API-Key: <value>. If MCP_JWT_SECRET is set, every HTTP request must
# also include Authorization: Bearer <HS256 JWT>.
# MCP_API_KEY=your-api-key-here
# MCP_JWT_SECRET=your-jwt-secret-here

# ---- Alert delivery (optional) ----
# Persisted alert rules are evaluated on trace_end. Webhook URLs are process
# configuration and are not stored in the database.
# MCP_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# MCP_ALERT_WEBHOOK=https://example.com/trace-alerts

# ---- Compliance audit log (optional) ----
# Default: ~/.mcp/trace-inspector-audit.jsonl
# MCP_AUDIT_LOG_PATH=/absolute/path/to/trace-inspector-audit.jsonl
