{
  "name": "mcp-agent-trace-inspector",
  "mcpName": "io.github.dbsectrainer/mcp-agent-trace-inspector",
  "version": "1.0.0",
  "description": "Step-by-step observability for MCP agent workflows",
  "author": "dbsectrainer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbsectrainer/mcp-agent-trace-inspector.git"
  },
  "homepage": "https://github.com/dbsectrainer/mcp-agent-trace-inspector#readme",
  "type": "module",
  "bin": {
    "mcp-agent-trace-inspector": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "observability",
    "tracing"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/yargs": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
